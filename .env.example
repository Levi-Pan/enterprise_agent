# 复制为 .env 并填写；不要提交真实密钥。
OPENAI_API_KEY=填写模型服务密钥
OPENAI_MODEL=填写账户可用且支持Responses的模型名称
ADMIN_API_TOKEN=填写随机生成的管理员密钥
# 可选：更换数据目录时必须填绝对路径。
# KNOWLEDGE_DB_PATH=D:/company_knowledge/knowledge.db
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
MODEL_CONCURRENCY=4
# 本地版允许员工创建账号；统一发放账号后可以关闭注册。
ALLOW_SELF_REGISTRATION=true
SESSION_LIFETIME_SECONDS=604800
# 本地 HTTP 为 false；部署 HTTPS 后设为 true。
SESSION_COOKIE_SECURE=false
RETRIEVAL_MODE=keyword
